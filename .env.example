# Copy to .env and fill in your Pushover credentials. Never commit .env.
# UPRN below is South Gloucestershire Council's own offices (a public building)
# and works as a live example — replace it with your own property's UPRN.
UPRN=661911
USUAL_COLLECTION_DAY=Monday
PUSHOVER_TOKEN=REPLACE_ME
PUSHOVER_USER_KEY=REPLACE_ME
LOG_LEVEL=INFO
